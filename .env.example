# =============================================================================
# PRODUCTION / VPS — copy to `.env` (gitignored)
#   cp .env.example .env
#
# Used by: docker-compose.modular.yml (canonical production stack) and
#          docker-compose.yml (deprecated lean variant).
# Not for local development infra (use docker-compose.local.yml +
# .env.local.example — see docs/08-LOCAL-DEVELOPMENT.md).
#
# IMPORTANT: infrastructure containers receive ONLY the variables mapped
# explicitly in the compose files. Never add vendor-prefixed keys (e.g.
# EMQX_*) here unless the compose file maps them on purpose.
# =============================================================================

# ── PostgreSQL (user data) ────────────────────────────────
POSTGRES_USER=selene_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=selene

# ── TimescaleDB (telemetry) ───────────────────────────────
TIMESCALE_USER=selene_ts
TIMESCALE_PASSWORD=CHANGE_ME_TIMESCALE_PASSWORD
TIMESCALE_DB=selene_measurements

# ── EMQX MQTT broker ──────────────────────────────────────
EMQX_NAME=selene
EMQX_ALLOW_ANONYMOUS=false
EMQX_AUTH_MECHANISM=password_based
EMQX_AUTH_BACKEND=built_in_database
EMQX_AUTH_USER_ID_TYPE=username
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_EMQX_DASHBOARD_PASSWORD
# NOTE: the dashboard credentials above only seed on the FIRST boot of a
# fresh emqx_data volume. The MQTT device user lives in the same volume
# (docs/03-EMQX-MQTT-RECOVERY.md).

# ── Service ports ─────────────────────────────────────────
AUTH_PORT=3009
ENERGY_PORT=3002
CLIMATE_PORT=3003
FIRMWARE_PORT=3004
INGESTOR_PORT=3005
BACKEND_PORT=8787
FRONTEND_PORT=3000

# ── Backend / auth security ───────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET
# JWT v2 (Ed25519) key pair — generate once during initial deployment
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Optional: require email confirmation for admin role elevation
# ELEVATION_CONFIRMATION=false

# ── Email (Resend) + public URL for reset links ───────────
# Real key only on the server (.env) — never commit secrets.
RESEND_API_KEY=
RESEND_FROM=Selene <onboarding@resend.dev>
APP_PUBLIC_URL=https://selene.dankehidayat.my.id
TOTP_ISSUER=Selene

# ── MQTT (backend → compose service name "emqx") ──────────
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_TOPIC=selene/+/telemetry
MQTT_USER=selene
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD

# ── Frontend (image build arg) ────────────────────────────
VITE_API_BASE_URL=https://selene.dankehidayat.my.id/api/v1
