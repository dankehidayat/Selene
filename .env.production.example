# =============================================================================
# Selene — Environment Configuration (Production/VPS)
# =============================================================================
# 
# WARNING: Never commit sensitive credentials! Use this file as template only.
# Run: cp .env.production.example .env   # First-time setup only
#
# All port configurations can be overridden in .env for different environments
# 

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (PostgreSQL - User Accounts & Auth)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=selene_admin
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=selene

# ─────────────────────────────────────────────────────────────────────────────
# TIMESCALE DB CONFIGURATION (Telemetry & Sensor Data)
# ─────────────────────────────────────────────────────────────────────────────
TIMESCALE_USER=selene_ts
TIMESCALE_PASSWORD=CHANGE_ME_SECURE_PASSWORD
TIMESCALE_DB=selene_measurements

# ─────────────────────────────────────────────────────────────────────────────
# EMQX MQTT BROKER (Real-time Messaging & Device Communication)
# ─────────────────────────────────────────────────────────────────────────────
EMQX_NAME=selene
EMQX_ALLOW_ANONYMOUS=false
EMQX_AUTH_MECHANISM=password_based
EMQX_AUTH_BACKEND=built_in_database
EMQX_AUTH_USER_ID_TYPE=username
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_SECURE_PASSWORD
EMQX_AUTHENTICATION__1__MECHANISM=password_based
EMQX_AUTHENTICATION__1__BACKEND=built_in_database
EMQX_AUTHENTICATION__1__USER_ID_TYPE=username
EMQX_AUTHENTICATION__1__PASSWORD_HASH_ALGORITHM__NAME=sha256

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE PORTS (Override these values per environment)
# Default values configured for VPS deployment
# Local development may use different ports
# ─────────────────────────────────────────────────────────────────────────────

# Core Microservices
AUTH_PORT=3009                # Auth Service (EdDSA JWT v2)
ENERGY_PORT=3002              # Energy Monitoring
CLIMATE_PORT=3003             # Climate Control
FIRMWARE_PORT=3004            # Firmware OTA Updates
INGESTOR_PORT=3005            # Telemetry Ingestion

# Legacy/Bridge Services  
BACKEND_PORT=8787             # Monolith Bridge (for transition period)
FRONTEND_PORT=4173            # Frontend Web App

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY TOKENS & KEYS
# ─────────────────────────────────────────────────────────────────────────────

# JWT v2 (Ed25519) - Asymmetric Key Pair for secure token signing
# These should be generated once during initial deployment
JWT_SECRET=CHANGE_ME_JWT_SECRET_HMAC_KEY
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL & NOTIFICATIONS (Resend Email API)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Selene <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Public URLs (must match your domain)
APP_PUBLIC_URL=https://selene.dankehidayat.my.id
VITE_API_BASE_URL=https://selene.dankehidayat.my.id/api/v1

# 2FA Configuration
TOTP_ISSUER=Selene
TOTP_PERIOD=30
TOTP_DIGITS=6

# ─────────────────────────────────────────────────────────────────────────────
# MQTT CONFIGURATION (Device Communication)
# ─────────────────────────────────────────────────────────────────────────────
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_TOPIC=selene/+/telemetry
MQTT_USER=selene
MQTT_PASSWORD=CHANGE_MQTT_CLIENT_PASSWORD
