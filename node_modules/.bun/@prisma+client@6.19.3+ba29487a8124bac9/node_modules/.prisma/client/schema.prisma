generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String?
  role                UserRole             @default(USER)
  isActive            Boolean              @default(true)
  /// When set, JWTs issued before this timestamp are rejected (password reset / change).
  passwordChangedAt   DateTime?
  /// TOTP second factor
  totpEnabled         Boolean              @default(false)
  /// AES-GCM ciphertext (base64) of the authenticator secret
  totpSecretEnc       String?
  /// JSON array of bcrypt-hashed one-time backup codes
  totpBackupHashes    String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  loginHistory        LoginHistory[]
  apiKeys             ApiKey[]
  passwordResetTokens PasswordResetToken[]
  refreshSessions     RefreshSession[]
}

/// Rotating refresh-token session (JWT v2). Only the SHA-256 hash of the
/// opaque token is stored. Rotation: each refresh replaces the row
/// (`replacedById`); presenting an already-replaced/revoked token is reuse
/// and revokes the whole chain.
model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  /// Optional client-supplied stable device identifier.
  deviceId     String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Points at the session that replaced this one during rotation.
  replacedById String?

  @@index([userId])
  @@index([expiresAt])
}

/// Provisioned device identities for node-to-API calls (firmware OTA).
/// Devices authenticate with `X-Device-Key`; only the SHA-256 hash is stored.
model DeviceNode {
  id         String    @id @default(cuid())
  nodeId     String    @unique
  keyHash    String    @unique
  name       String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model GlossaryTerm {
  id         String   @id @default(cuid())
  term       String
  definition String
  category   String   @default("General")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ApiKey {
  id        String    @id @default(cuid())
  key       String    @unique
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
}
