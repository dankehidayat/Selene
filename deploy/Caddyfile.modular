{
	admin localhost:2019
	email admin@labdha.com
}

# HTTP redirect to HTTPS
:80 {
	redir https://{host}{uri} permanent
}

selene.dankehidayat.my.id {

	# Health check
	handle /health {
		reverse_proxy localhost:3009
	}

	# API → monolith (full auth/admin/2fa/notifications/readings/analytics/firmware/mqtt/glossary).
	# Frontend contract is /api/v1/* (per openapi-v1.yml). Monolith registers at /api/*,
	# so rewrite the /v1 segment away → /api/* → 8787. Once a microservice takes over a
	# v1 route (services/auth etc.), give its prefix its own route ABOVE this one.
	route /api/v1/* {
		uri path_regexp ^/api/v1/(.*)$ /api/$1
		reverse_proxy localhost:8787
	}

	route /api/* {
		reverse_proxy localhost:8787
	}

	# Frontend SPA routing
	# NOTE: FRONTEND_PORT in .env controls the published host port (default 3000)
	route * {
		reverse_proxy localhost:3000
	}

	encode gzip zstd
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "SAMEORIGIN"
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

emqx.dankehidayat.my.id {
	# EMQX redirects / → /dashboard/ itself; do NOT rewrite (breaks static assets)
	reverse_proxy localhost:18083
	encode gzip zstd
}