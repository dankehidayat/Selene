{
	admin localhost:2019
	email admin@labdha.com
}

# HTTP redirect to HTTPS
:80 {
	redir https://{host}{uri} permanent
}

selene.dankehidayat.my.id {

	# Health checks
	handle /health {
		reverse_proxy localhost:3009
	}

	handle /.well-known/jwks.json {
		reverse_proxy localhost:3009
	}

	# v1 API routes - AUTH service
	route /api/v1/auth/* {
		rewrite * {path}
		reverse_proxy localhost:3009
	}

	route /api/v1/me* {
		rewrite * {path}
		reverse_proxy localhost:3009
	}

	route /api/v1/admin/* {
		rewrite * {path}
		reverse_proxy localhost:3009
	}

	route /api/v1/notifications* {
		rewrite * {path}
		reverse_proxy localhost:3009
	}

	route /api/v1/glossary {
		rewrite * {path}
		reverse_proxy localhost:3009
	}

	# v1 API routes - ANALYTICS service
	route /api/v1/analytics/* {
		rewrite * {path}
		reverse_proxy localhost:3006
	}

	# Legacy /api/* → monolith (includes readings, old endpoints)
	route /api/* {
		reverse_proxy localhost:8787
	}

	# Frontend SPA routing
	rewrite * /{path}
	route * {
		reverse_proxy localhost:3000
	}

	encode gzip zstd
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "SAMEORIGIN"
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

emqx.dankehidayat.my.id {
	rewrite * /dashboard/login
	reverse_proxy localhost:18083
	encode gzip zstd
}
